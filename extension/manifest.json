{
  "manifest_version": 3,
  "name": "AuditMyTime.RPG",
  "version": "1.0.0",
  "description": "A privacy-first, gamified focus manager powered by Gemini Nano and Web Crypto.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
